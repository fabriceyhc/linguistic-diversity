{
  "_meta": {
    "purpose": "Held-out data for screening sentence embedders for similarity-sensitive Hill numbers.",
    "authored_by": "Hand-authored for this repository. Not human-validated by external annotators.",
    "held_out_from": "The corpus1/corpus2 example in the README, which was used to tune metric settings. No sentence here reuses those phrasings.",
    "design": {
      "synonymy_clusters": "Each cluster is ONE concept expressed 4 ways with deliberately varied wording. A corpus built from k clusters has ground-truth effective diversity k, regardless of how many sentences it contains. Tests whether a model COLLAPSES paraphrases.",
      "polysemy_sets": "Each set shares a surface form across unrelated senses. A set of n sentences has ground-truth effective diversity n. Tests whether a model SEPARATES meanings despite lexical overlap.",
      "why_both": "A model can trivially win either axis alone: one that calls everything similar aces synonymy and fails polysemy, and vice versa. Only a calibrated similarity scale passes both."
    },
    "domains_note": "The domain field enables hard sampling: drawing k clusters from a single domain yields semantically adjacent concepts, which is a much harder test than drawing across domains."
  },

